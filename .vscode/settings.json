{
    "java.compile.nullAnalysis.mode": "automatic",
    "git.decorations.enabled": true,
    "git.ignoreLimitWarning": true,
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/**": true,
        "**/frontend/node_modules/**": true,
        "**/.angular/**": true
    },
    "search.exclude": {
        "**/node_modules": true,
        "**/bower_components": true,
        "**/*.code-search": true,
        "**/.angular": true
    }
}